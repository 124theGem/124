# Local browser play needs no Telegram token: npm run dev
NODE_ENV=development
HOST=127.0.0.1
PORT=8003
DATABASE_PATH=./data/planets.sqlite
# Required only for Telegram login and production. Never put this in VITE_*.
BOT_TOKEN=
# Optional public bot username for squad links; otherwise resolved on first invitation.
RAID_BOT_USERNAME=
# Stars remain CLOSED unless explicitly enabled AND the existing Telegram webhook
# already matches RAID_APP_URL/api/raid/payments/telegram. Never replaces a webhook automatically.
RAID_STARS_ENABLED=false
RAID_APP_URL=
RAID_STARS_WEBHOOK_SECRET=
