{
  "name": "little-planets",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:client": "vite --host 0.0.0.0 --port 5174 --strictPort",
    "dev:server": "tsx watch server/index.ts",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts",
    "test": "vitest run",
    "test:browser": "node tests/browser.mjs",
    "test:production": "tsx tests/production-browser.ts",
    "package:server": "npm run build && node scripts/package-server.mjs",
    "test:upgrade": "node --import tsx tests/upgrade.mjs",
    "test:frontiers": "node --import tsx tests/frontiers-browser.mjs",
    "test:events": "node --import tsx tests/events-browser.mjs",
    "test:runtime": "node tests/runtime.mjs"
  },
  "dependencies": {
    "three": "^0.180.0",
    "fastify": "^5.6.1",
    "@fastify/static": "^8.3.0",
    "@fastify/rate-limit": "^10.3.0",
    "dotenv": "^17.2.3",
    "tsx": "^4.20.6",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "typescript": "~5.9.3",
    "vite": "^7.1.12",
    "vitest": "^3.2.4",
    "@types/three": "^0.180.0",
    "@types/node": "^24.0.0",
    "@playwright/test": "^1.56.0"
  }
}
