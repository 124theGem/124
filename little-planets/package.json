{
  "name": "little-planets",
  "version": "0.16.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:client": "vite --host 0.0.0.0 --port 5174 --strictPort",
    "dev:server": "tsx watch server/index.ts",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts",
    "test": "vitest run",
    "test:browser": "npm run test:flightdeck && npm run test:firstlight && npm run test:horizon && npm run test:outpost && npm run test:atlas",
    "test:production": "tsx tests/production-browser.ts",
    "package:server": "npm run build && node scripts/package-server.mjs",
    "test:upgrade": "node --import tsx tests/upgrade.mjs",
    "test:frontiers": "node --import tsx tests/frontiers-browser.mjs",
    "test:events": "node --import tsx tests/events-browser.mjs",
    "test:runtime": "node tests/runtime.mjs",
    "test:odyssey": "node --import tsx tests/odyssey-browser.mjs",
    "test:sanctuary": "node --import tsx tests/sanctuary-browser.mjs",
    "test:cubeworks": "node --import tsx tests/cubeworks-browser.mjs",
    "test:journey": "node --import tsx tests/journey-browser.mjs",
    "test:aurora": "node --import tsx tests/aurora-browser.mjs",
    "test:flightdeck": "node --import tsx tests/flightdeck-browser.mjs",
    "test:outfit": "node --import tsx tests/outfit-browser.mjs",
    "test:firstlight": "node --import tsx tests/firstlight-browser.mjs",
    "test:dawn": "FIRSTLIGHT_RESET=1 FIRSTLIGHT_SCOPE=intro node --import tsx tests/firstlight-browser.mjs",
    "test:horizon": "node --import tsx tests/horizon-browser.mjs",
    "test:outpost": "node --import tsx tests/outpost-browser.mjs",
    "test:atlas": "node --import tsx tests/atlas-browser.mjs",
    "test:atlas-models": "node --import tsx tests/atlas-models-browser.mjs"
  },
  "dependencies": {
    "three": "^0.180.0",
    "fastify": "^5.6.1",
    "@fastify/static": "^8.3.0",
    "@fastify/rate-limit": "^10.3.0",
    "dotenv": "^17.2.3",
    "tsx": "^4.20.6",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "typescript": "~5.9.3",
    "vite": "^7.1.12",
    "vitest": "^3.2.4",
    "@types/three": "^0.180.0",
    "@types/node": "^24.0.0",
    "@playwright/test": "^1.56.0"
  }
}
